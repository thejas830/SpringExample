<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- bean definitions here -->
    <bean id="userDatabaseProvider" class="com.inversionOfControl.UserDatabaseProvider"/>
    <bean id="webDatabaseProvider" class="com.inversionOfControl.WebDatabaseProvider"/>

    <bean id="userManagerWithUserDataBaseProvider" class="com.inversionOfControl.UserManager">
        <constructor-arg ref="userDatabaseProvider" />
    </bean>
    <bean id="userManagerWithWebDataBaseProvider" class="com.inversionOfControl.UserManager">
        <constructor-arg ref="webDatabaseProvider" />
    </bean>

</beans>